# --- Auth ---
secret_key=
algorithm=HS256
access_token_expires_minutes=30

# --- Database ---
database_url=postgresql+psycopg://user:password@localhost:5432/ai-vacation-db

# --- Email (welcome mail background task) ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# --- LLM / agent (phase 5) ---
# The only credential the AI features need; weather, maps and pricing tools
# use keyless APIs.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
AGENT_RECURSION_LIMIT=18
ITINERARY_MAX_REVISIONS=2

# --- RAG ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=4
